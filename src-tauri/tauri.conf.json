{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ViliCom",
  "version": "0.1.0-alpha",
  "identifier": "com.vilinox.vilicom",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ViliCom v0.1.0-alpha",
        "width": 1100,
        "height": 720,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "aikoderbot",
    "copyright": "Copyright © 2026 aikoderbot <aikoderbot@mail.grokbot.com>",
    "shortDescription": "ViliCom - Modern Cross-Platform Serial & Log Studio",
    "longDescription": "ViliCom is a lightweight, cross-platform serial communication and log recording studio built with Tauri v2 and Rust for embedded hardware debugging.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
